# Copy to .env and fill in real values. Never commit .env — it is gitignored.

# PostgreSQL connection string (Neon / Vercel Postgres / any Postgres).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret used to sign the admin session cookie. Generate a fresh random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string"

# Only read by `prisma/seed.ts` when creating the initial admin account.
# Not needed at runtime.
ADMIN_PASSWORD="choose-a-strong-password"
